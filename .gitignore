# --------------------------------------------------
# Terraform files and folders
# --------------------------------------------------
# Terraform state files (sensitive information)
*.tfstate
*.tfstate.*
# Local Terraform working directory
**/.terraform/*
# Terraform crash log files
crash.log
# Local Terraform overrides (should not be shared)
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Terraform variable definition files (can contain secrets)
*.tfvars
variables_sec.tf
# Environment override file (custom env values)
.env.override

# --------------------------------------------------
# IDE / Editor
# --------------------------------------------------
# Visual Studio Code
.vscode/
.vscode
.history/
# JetBrains IDEs
.idea/
# Visual Studio cache/options directory
.vs/
# TernJS port file
.tern-port

# --------------------------------------------------
# Node.js
# --------------------------------------------------
# Downloaded packages
node_modules/
node_modules
.node_env
nodeenv
# Azure Static Web Apps managed functions (api/) — local secrets, never commit
api/local.settings.json
# Debug logs and other package-manager lock files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-lock.yaml
.yarn-integrity
# npm / eslint caches and REPL history
.npm
.eslintcache
.node_repl_history
# Output of 'npm pack'
*.tgz
# dotenv environment variables
.env
.env.test
# NOTE: package.json and package-lock.json are intentionally TRACKED in this repo.
#       The Static Web App / GitHub Pages workflow runs `npm ci`, which requires the
#       committed package-lock.json to be present and in sync. Do NOT ignore them here.

# --------------------------------------------------
# PowerShell temporary and backup files
# --------------------------------------------------
*.ps1~
*.psm1~
*.tmp.ps1

# --------------------------------------------------
# Python temporary files and folders
# --------------------------------------------------
# Cache and compiled files
__pycache__/
*.py[cod]
*.pyo
*.pyd
# Virtual environments
.Python
env/
venv/
.venv/
ENV/
**/bin/
**/lib/
**/include/
**/pyvenv.cfg
# Build artefacts
build/
dist/
*.egg-info/

# --------------------------------------------------
# Logs
# --------------------------------------------------
logs
*.log

# --------------------------------------------------
# Coverage / test artefacts
# --------------------------------------------------
coverage
*.lcov
.nyc_output
lib-cov

# --------------------------------------------------
# TypeScript
# --------------------------------------------------
typings/
*.tsbuildinfo

# --------------------------------------------------
# Compiled binaries
# --------------------------------------------------
*.exe
*.dll
*.so
*.dylib
*.bin
*.out
*.app

# --------------------------------------------------
# Backup and temporary files
# --------------------------------------------------
*.bak
*.tmp
*.orig
*.zip

# --------------------------------------------------
# Certificates and keys
# --------------------------------------------------
*.key
*.crt
*.csr

# --------------------------------------------------
# Cloudflare and platform tooling
# --------------------------------------------------
cloudflare-test/*
cloudflare-zerodowntime/*
!config/cloudflare_traffic/axpo.app/
!config/cloudflare_traffic/axpo.app/**
.sonarlint/connectedMode.json
scripts/hooks/platform/certificates/test.sh

# --------------------------------------------------
# AI assistant configuration (local / personal)
# --------------------------------------------------
# Personal settings and instructions — not shared across team
AGENTS.local.md
CLAUDE.local.md
# Agent tool settings — local overrides
.agents/settings.local.json
.claude/settings.local.json
.copilot/settings.local.json
# Agent working memory and plans
.agents/memory/
.agents/plans/
# Agent session transcripts, logs and temporary outputs
.agents/**/*.jsonl
.agents/transcripts/
.agents/worktrees/
.agents/tmp/
.claude/tmp/
.omo
# Cursor
.cursorrules.local
.cursor/rules/*.local.md
# opencode (AI coding tool) local config
.opencode/settings.local*
.opencode/tmp/
.opencode/**/*.jsonl

# --------------------------------------------------
# Graphify cache and temporary files
# (keep graph.json, GRAPH_REPORT.md, graph.html, manifest.json)
# --------------------------------------------------
graphify-out/.graphify_*
graphify-out/cache/
graphify-out/cost.json
graphify-out/obsidian/

# --------------------------------------------------
# ANTLR (MADR parser — src/plugins/parser)
# --------------------------------------------------
.antlr
*.interp
*.tokens

# --------------------------------------------------
# System files (Windows and macOS)
# --------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
# macOS
.DS_Store
.AppleDouble
.LSOverride
